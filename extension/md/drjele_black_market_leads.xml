<?xml version="1.0" encoding="utf-8"?>
<mdscript name="DrJele_BlackMarketLeads" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="md.xsd">
    <cues>

        <cue name="Configuration" instantiate="true" namespace="static" version="1">
            <conditions>
                <event_cue_signalled cue="md.Setup.Start"/>
            </conditions>
            <actions>
                <set_value name="$ForceMode" exact="'station'" comment="'station' runs the whole vanilla leak pass, 'leak' places a single black market lead - see DEVELOPMENT.md"/>
                <set_value name="$ForceLeaks" exact="1" comment="1 plants a lead on a station whose marketeer is still locked"/>
                <set_value name="$ForceCooldown" exact="30min" comment="game time between two attempts on the same station"/>
                <set_value name="$MaxAttemptsPerStation" exact="5" comment="give up on a station after this many attempts, until its marketeer unlocks"/>
                <set_value name="$MaxLeaksPerStation" exact="6" comment="never push a station past this many signal leaks - the vanilla hard cap is 8"/>
                <set_value name="$MaxVoiceLeaks" exact="1" comment="skip a station that already carries this many mission leaks"/>
                <set_value name="$MinFreeSlots" exact="2" comment="vanilla rolls its leak count against count/2, so a single free slot is not enough"/>
                <set_value name="$Notify" exact="1" comment="1 shows a ticker line the first time a lead is spotted"/>
                <set_value name="$Logbook" exact="1" comment="1 writes a logbook entry that opens the map on the station"/>
                <set_value name="$ListLocked" exact="1" comment="1 lists still locked marketeers in the menu"/>
                <set_value name="$ListUnlocked" exact="1" comment="1 lists already unlocked marketeers in the menu"/>
                <set_value name="$DebugChance" exact="0" comment="100 writes every decision to the debug log"/>

                <set_value name="global.$DrJeleBlackMarketLeadsConfig" exact="table[
                    $ForceMode             = $ForceMode,
                    $ForceLeaks            = $ForceLeaks,
                    $ForceCooldown         = $ForceCooldown,
                    $MaxAttemptsPerStation = $MaxAttemptsPerStation,
                    $MaxLeaksPerStation    = $MaxLeaksPerStation,
                    $MaxVoiceLeaks         = $MaxVoiceLeaks,
                    $MinFreeSlots          = $MinFreeSlots,
                    $Notify                = $Notify,
                    $Logbook               = $Logbook,
                    $ListLocked            = $ListLocked,
                    $ListUnlocked          = $ListUnlocked,
                    $DebugChance           = $DebugChance,
                    ]"/>

                <debug_text text="'DrJele black market leads: configuration loaded, force mode %s'.[$ForceMode]"
                            chance="if global.$DrJeleBlackMarketDebugChance? then global.$DrJeleBlackMarketDebugChance else $DebugChance"/>
            </actions>
        </cue>

        <!-- State and the cues that listen on it have to be one cue tree: a sibling cue's group does not
             exist yet when the events are set up, which is what "Evaluated value 'null' is not of type
             group" means. Vanilla keeps groups and their listeners together the same way, in
             Signal_Leaks.Manager and NPC_ShadyGuy.GameStarted. -->
        <cue name="Watcher" version="1">
            <actions>
                <set_value name="$Attempts" exact="table[]" comment="{$station} = [last attempt, attempts, last seen]"/>
                <set_value name="$Announced" exact="table[]" comment="{$station} = when the lead was first reported"/>
                <!-- Stations in the player's current sector that carry a still locked marketeer.
                     Everything the mod does hangs off events on this handful of objects, so there is no polling. -->
                <create_group groupname="$Watched"/>
            </actions>
            <cues>

                <!-- The only galaxy-wide pass. It happens once per sector change, and once on every savegame
                     load so that installing the mod without moving still fills the watch group. Same pair of
                     triggers vanilla uses in Signal_Leaks.Manager.PlayerChangesSpace. -->
                <cue name="SectorPass" instantiate="true" namespace="this">
                    <conditions>
                        <check_any>
                            <event_cue_signalled cue="md.Setup.Start"/>
                            <event_object_changed_sector object="player.entity"/>
                        </check_any>
                        <check_value value="macro.xu_ep2_universe_macro == player.galaxy.macro" comment="main galaxy only - leaves Timelines scenarios, tutorials and the workshop untouched"/>
                    </conditions>
                    <delay exact="2s" comment="on a load the player entity and the marketeer table settle a moment after Setup.Start"/>
                    <actions>
                        <clear_group group="Watcher.$Watched"/>
                        <include_actions ref="PruneState"/>

                        <do_if value="player.sector and md.$ShadyGuyMap?">
                            <do_for_each name="$ShadyGuy" valuename="$Station" in="md.$ShadyGuyMap">
                                <do_if value="not @$Station.exists or not $Station.isclass.station">
                                    <continue/>
                                </do_if>
                                <do_if value="$Station.sector != player.sector">
                                    <continue/>
                                </do_if>
                                <do_if value="not @$ShadyGuy.exists or $ShadyGuy.tradesvisible">
                                    <continue/>
                                </do_if>

                                <!-- Watched before the isknown check, so a station discovered later in this sector still fires. -->
                                <add_to_group groupname="Watcher.$Watched" object="$Station"/>

                                <do_if value="$Station.isknown">
                                    <include_actions ref="ReportLead"/>
                                    <do_if value="$Station.attention ge attention.visible">
                                        <signal_cue_instantly cue="PlantCheck" param="$Station"/>
                                    </do_if>
                                </do_if>
                            </do_for_each>
                        </do_if>

                        <debug_text text="'DrJele black market leads: %s watched station(s) in %s'.[Watcher.$Watched.count, @player.sector.knownname]"
                                    chance="if global.$DrJeleBlackMarketDebugChance? then global.$DrJeleBlackMarketDebugChance else 0"/>
                    </actions>
                </cue>

                <!-- No namespace: the group in the event condition has to resolve in the parent's namespace,
                     exactly like Signal_Leaks.Manager.ObjectChangedAttention. Action blocks run atomically,
                     so sharing $Station with the sibling below is safe. -->
                <cue name="MarketeerKnown" instantiate="true">
                    <conditions>
                        <event_object_known_to_player group="$Watched"/>
                    </conditions>
                    <actions>
                        <set_value name="$Station" exact="event.object"/>
                        <include_actions ref="ReportLead"/>
                        <do_if value="@$Station.attention ge attention.visible">
                            <signal_cue_instantly cue="PlantCheck" param="$Station"/>
                        </do_if>
                    </actions>
                </cue>

                <!-- Flying up to the station is the trigger; that is also the moment vanilla itself seeds leaks. -->
                <cue name="MarketeerApproached" instantiate="true">
                    <conditions>
                        <event_object_changed_attention group="$Watched"/>
                        <check_value value="event.param ge attention.visible and event.param2 lt attention.visible"/>
                    </conditions>
                    <actions>
                        <set_value name="$Station" exact="event.object"/>
                        <do_if value="@$Station.isknown">
                            <include_actions ref="ReportLead"/>
                            <signal_cue_instantly cue="PlantCheck" param="$Station"/>
                        </do_if>
                    </actions>
                </cue>

                <!-- namespace="this" because instances overlap across the delay, and event.param is captured
                     before it: after a delay the event is no longer the current one. -->
                <cue name="PlantCheck" instantiate="true" namespace="this">
                    <conditions>
                        <event_cue_signalled/>
                    </conditions>
                    <actions>
                        <set_value name="$Station" exact="event.param"/>
                    </actions>
                    <delay exact="30s" comment="let the vanilla leak pass for this station finish first - PlaceMissionLeakOnSurface waits 5s and then retries up to ten times"/>
                    <actions>
                        <run_actions ref="PlantLead">
                            <param name="Station" value="$Station"/>
                        </run_actions>
                    </actions>
                </cue>

            </cues>
        </cue>

        <!-- purpose="run_actions" so the guards can bail out with <return/>, which a cue cannot do. -->
        <library name="PlantLead" purpose="run_actions">
            <params>
                <param name="Station"/>
            </params>
            <actions>
                <set_value name="$Config" exact="if global.$DrJeleBlackMarketLeadsConfig? then global.$DrJeleBlackMarketLeadsConfig else table[]"/>
                <set_value name="$DebugChance" exact="if global.$DrJeleBlackMarketDebugChance? then global.$DrJeleBlackMarketDebugChance else (if $Config.$DebugChance? then $Config.$DebugChance else 0)"/>
                <set_value name="$ForceLeaks" exact="if global.$DrJeleBlackMarketForceLeaks? then global.$DrJeleBlackMarketForceLeaks else (if $Config.$ForceLeaks? then $Config.$ForceLeaks else 1)"/>
                <set_value name="$ForceCooldown" exact="if global.$DrJeleBlackMarketForceCooldown? then global.$DrJeleBlackMarketForceCooldown else (if $Config.$ForceCooldown? then $Config.$ForceCooldown else 30min)"/>
                <set_value name="$ForceMode" exact="if $Config.$ForceMode? then $Config.$ForceMode else 'station'"/>
                <set_value name="$MaxAttempts" exact="if $Config.$MaxAttemptsPerStation? then $Config.$MaxAttemptsPerStation else 5"/>
                <set_value name="$MaxLeaks" exact="if $Config.$MaxLeaksPerStation? then $Config.$MaxLeaksPerStation else 6"/>
                <set_value name="$MaxVoiceLeaks" exact="if $Config.$MaxVoiceLeaks? then $Config.$MaxVoiceLeaks else 1"/>
                <set_value name="$MinFreeSlots" exact="if $Config.$MinFreeSlots? then $Config.$MinFreeSlots else 2"/>

                <do_if value="1 != $ForceLeaks">
                    <return/>
                </do_if>
                <do_if value="not @$Station.exists or not $Station.isclass.station or not $Station.isknown">
                    <return/>
                </do_if>
                <set_value name="$ShadyGuy" exact="@$Station.shadyguy"/>
                <do_if value="not $ShadyGuy">
                    <debug_text text="'DrJele black market leads: %s has no marketeer any more'.[$Station.knownname]" chance="$DebugChance"/>
                    <return/>
                </do_if>
                <do_if value="$ShadyGuy.tradesvisible">
                    <remove_from_group group="Watcher.$Watched" object="$Station"/>
                    <debug_text text="'DrJele black market leads: %s is already unlocked'.[$Station.knownname]" chance="$DebugChance"/>
                    <return/>
                </do_if>
                <do_if value="$Station.attention lt attention.visible">
                    <debug_text text="'DrJele black market leads: %s dropped out of attention again'.[$Station.knownname]" chance="$DebugChance"/>
                    <return/>
                </do_if>
                <!-- GM_BringItems__Trigger bails out without docking permission, and the leak it just made is destroyed again. -->
                <do_if value="not $Station.hasrelation.dock.{faction.player}">
                    <debug_text text="'DrJele black market leads: no docking permission at %s, a lead there would be destroyed again'.[$Station.knownname]" chance="$DebugChance"/>
                    <return/>
                </do_if>
                <do_if value="@md.GenericMissions.Manager.$Disabled">
                    <return/>
                </do_if>
                <do_if value="@md.Signal_Leaks.Manager.$SuppressSignalLeakGeneration">
                    <return/>
                </do_if>
                <do_if value="@md.Signal_Leaks.Manager.$ExcludedMissionFactions.indexof.{$Station.owner}">
                    <debug_text text="'DrJele black market leads: %s is owned by %s, which the game excludes from mission leaks'.[$Station.knownname, $Station.owner.name]" chance="$DebugChance"/>
                    <return/>
                </do_if>
                <do_if value="@md.GenericMissions.Manager.$ExcludedOfferObjects.indexof.{$Station}">
                    <return/>
                </do_if>
                <!-- A queued cleanup makes GenerateSignalLeaks take its abort branch, which would burn the
                     attempt. Tested through keys.indexof because '@' cannot be combined with '?'. -->
                <do_if value="@md.Signal_Leaks.Manager.$CleanupTable.keys.indexof.{$Station}">
                    <debug_text text="'DrJele black market leads: the game has a leak cleanup queued for %s'.[$Station.knownname]" chance="$DebugChance"/>
                    <return/>
                </do_if>
                <do_if value="@Watcher.$Attempts.{$Station} and (player.age - Watcher.$Attempts.{$Station}.{1}) lt $ForceCooldown">
                    <return/>
                </do_if>
                <do_if value="@Watcher.$Attempts.{$Station} and Watcher.$Attempts.{$Station}.{2} ge $MaxAttempts">
                    <return/>
                </do_if>

                <!-- Mirrors the census in Signal_Leaks.CalculateLeakCounts, so the station never ends up over-seeded. -->
                <find_object_component name="$ExistingLeaks" object="$Station" class="class.signalleak" multiple="true"/>
                <do_if value="not @$ExistingLeaks.count">
                    <set_value name="$ExistingLeaks" exact="[]"/>
                </do_if>
                <set_value name="$VoiceLeaks" exact="0"/>
                <do_for_each name="$Leak" in="$ExistingLeaks">
                    <do_if value="$Leak.type == signalleaktype.voice">
                        <set_value name="$VoiceLeaks" operation="add"/>
                    </do_if>
                </do_for_each>
                <!-- A mission leak is already sitting on the hull; vanilla put it there and it is the one to scan. -->
                <do_if value="$VoiceLeaks ge $MaxVoiceLeaks or $ExistingLeaks.count ge $MaxLeaks">
                    <!-- controlentity is what Signal_Leaks.GenerateSignalLeaks tests before it swaps in the
                         black market mission table, so it is logged here: null would mean no pass on this
                         station can ever produce the unlock lead. -->
                    <debug_text text="'DrJele black market leads: %s already carries %s leak(s), %s of them mission leaks - nothing to add. shadyguy=%s controlentity=%s locked=%s dockable=%s'.[$Station.knownname, $ExistingLeaks.count, $VoiceLeaks, $ShadyGuy.knownname, @$Station.controlentity.{controlpost.shadyguy}.knownname, not $ShadyGuy.tradesvisible, $Station.hasrelation.dock.{faction.player}]" chance="$DebugChance"/>
                    <return/>
                </do_if>

                <!-- Same slot filter as Signal_Leaks.GetLeakSlots, replicated rather than referenced across scripts. -->
                <find_signalleak_location name="$Slots" container="$Station" excludefilled="true" multiple="true"/>
                <do_if value="not @$Slots.count">
                    <set_value name="$Slots" exact="[]"/>
                </do_if>
                <do_all exact="$Slots.count" counter="$SlotIndex" reverse="true">
                    <do_if value="not $Slots.{$SlotIndex}.component.isoperational">
                        <remove_value name="$Slots.{$SlotIndex}"/>
                    </do_if>
                </do_all>
                <do_if value="$Slots.count lt $MinFreeSlots">
                    <debug_text text="'DrJele black market leads: only %s free leak slot(s) on %s'.[$Slots.count, $Station.knownname]" chance="$DebugChance"/>
                    <return/>
                </do_if>

                <do_if value="$ForceMode == 'leak'">
                    <signal_cue_instantly cue="md.Signal_Leaks.Manager.PlaceMissionLeakOnSurface"
                                          param="[$Slots.random, table[{md.Signal_Leaks.Manager.GM_BringItems__Trigger} = table[
                                              $MissionType = missiontype.deliver,
                                              $Page        = 30135,
                                              $TextOffset  = [1000, 1100],
                                              $Station     = $Station,
                                              $debugchance = 0,
                                              ]]]"/>
                </do_if>
                <do_else>
                    <!-- The vanilla pass: its first mission leak on a station with a marketeer is always the unlock one. -->
                    <signal_cue_instantly cue="md.Signal_Leaks.Manager.GenerateSignalLeaks" param="$Station"/>
                </do_else>

                <set_value name="Watcher.$Attempts.{$Station}"
                           exact="[player.age, (if @Watcher.$Attempts.{$Station} then Watcher.$Attempts.{$Station}.{2} else 0) + 1, player.age]"/>
                <debug_text text="'DrJele black market leads: planted a lead on %s (%s), attempt %s, mode %s'.[$Station.knownname, $Station.sector.knownname, Watcher.$Attempts.{$Station}.{2}, $ForceMode]"
                            chance="$DebugChance"/>
            </actions>
        </library>

        <!-- Reports a station once. Expects $Station in the caller's namespace. -->
        <library name="ReportLead">
            <actions>
                <set_value name="$ReportLogbook" exact="if global.$DrJeleBlackMarketLogbook? then global.$DrJeleBlackMarketLogbook else (if @global.$DrJeleBlackMarketLeadsConfig.$Logbook then global.$DrJeleBlackMarketLeadsConfig.$Logbook else 1)"/>
                <set_value name="$ReportNotify" exact="if global.$DrJeleBlackMarketNotify? then global.$DrJeleBlackMarketNotify else (if @global.$DrJeleBlackMarketLeadsConfig.$Notify then global.$DrJeleBlackMarketLeadsConfig.$Notify else 1)"/>
                <do_if value="1 == $ReportLogbook and @$Station.exists and not @Watcher.$Announced.{$Station}">
                    <set_value name="Watcher.$Announced.{$Station}" exact="player.age"/>
                    <do_if value="$Station.hasrelation.dock.{faction.player}">
                        <set_value name="$ReportText" exact="'%s - %s. Scan the hull: the black market lead is one of its mission leaks.'.[$Station.knownname, $Station.sector.knownname]"/>
                    </do_if>
                    <do_else>
                        <set_value name="$ReportText" exact="'%s - %s. No docking permission, so this one cannot be unlocked yet.'.[$Station.knownname, $Station.sector.knownname]"/>
                    </do_else>
                    <write_to_logbook category="tips" interaction="showonmap" object="$Station"
                                      title="{20208,10801}" text="$ReportText"/>
                    <do_if value="1 == $ReportNotify">
                        <show_notification text="'%s: %s'.[{20208,10801}, $Station.knownname]" timeout="6s"/>
                    </do_if>
                    <remove_value name="$ReportText"/>
                </do_if>
                <remove_value name="$ReportLogbook"/>
                <remove_value name="$ReportNotify"/>
            </actions>
        </library>

        <!-- Reverse iteration is mandatory: the table is mutated while it is walked. -->
        <library name="PruneState">
            <actions>
                <do_all exact="Watcher.$Attempts.keys.count" counter="$PruneIndex" reverse="true">
                    <set_value name="$PruneKey" exact="Watcher.$Attempts.keys.list.{$PruneIndex}"/>
                    <do_if value="not @$PruneKey.exists or @$PruneKey.shadyguy.tradesvisible or (player.age - Watcher.$Attempts.{$PruneKey}.{3}) gt 2h">
                        <remove_value name="Watcher.$Attempts.{$PruneKey}"/>
                    </do_if>
                </do_all>
                <do_all exact="Watcher.$Announced.keys.count" counter="$PruneIndex" reverse="true">
                    <set_value name="$PruneKey" exact="Watcher.$Announced.keys.list.{$PruneIndex}"/>
                    <do_if value="not @$PruneKey.exists or @$PruneKey.shadyguy.tradesvisible">
                        <remove_value name="Watcher.$Announced.{$PruneKey}"/>
                    </do_if>
                </do_all>
                <remove_value name="$PruneKey"/>
            </actions>
        </library>

    </cues>
</mdscript>
